{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "jsx": "react-jsx",
    "jsxImportSource": "@revideo/2d/lib",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*"]
}
